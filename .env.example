# 필수: 서울 열린데이터광장(data.seoul.go.kr)에서 발급
SEOUL_OPEN_API_KEY=

# 필수: Kakao Developers(developers.kakao.com)에서 REST API 키 발급
KAKAO_REST_API_KEY=

# 필수: SGIS 개발지원센터(sgis.kostat.go.kr)에서 발급
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 공공데이터포털(data.go.kr) — SEMAS 상가업소 수집.
# 없어도 콜드스타트는 완주하지만 store 가 비어 pipeline.consistency 의
# crosssource(인허가 밀도 ↔ 소상공인 밀도 상관) 검사가 실패합니다.
# 게이트 4종을 통과한 DB 를 원하면 채우세요.
DATA_GO_KR_SERVICE_KEY=

# 선택: 지도에서 칸을 고를 때 그 안의 건물 외곽선(GET /api/grid/{id}/footprints).
# 브이월드(vworld.kr)에서 발급하고 **데이터API 활용신청**까지 해야 합니다 —
# 키만 있고 신청이 없으면 지오코딩만 되고 데이터API 는 «인증키 정보가 올바르지
# 않습니다» 를 냅니다. 콜드스타트·게이트 4종에는 필요 없고, 비워두면 건물
# 외곽선만 안 그려지며 등급·추천·손익·권리금은 전부 정상 동작합니다.
VWORLD_API_KEY=

# 선택: 부동산원 참고값(권리금 실태·상가 임대료·공실률·층별 효용비율).
# reb.or.kr/r-one 에서 발급하며 data.go.kr 키와 별개입니다. 수집은 파이프라인
# 18단계에 들어가지 않고 `python -m pipeline.rone` 로 따로 돌립니다 — 점수·등급·
# 추천 순위에 기여하지 않아 없어도 제품이 성립하기 때문입니다. 비워두면 손익·
# 권리금 화면에서 «시세와 견주면» 줄만 사라집니다.
RONE_API_KEY=

# 선택: 상세 화면의 «AI는 이 자리를 이렇게 요약했어요»(POST /api/report) 전용.
# 콜드스타트·게이트 4종에는 필요 없습니다. 비워두면 그 카드만 오류를 표시하고
# 등급·추천·손익·권리금은 전부 정상 동작합니다.
OPENAI_API_KEY=
