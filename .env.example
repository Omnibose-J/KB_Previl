# 필수: 서울 열린데이터광장(data.seoul.go.kr)에서 발급
SEOUL_OPEN_API_KEY=

# 필수: Kakao Developers(developers.kakao.com)에서 REST API 키 발급
KAKAO_REST_API_KEY=

# 필수: SGIS 개발지원센터(sgis.kostat.go.kr)에서 발급
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 선택: 공공데이터포털(data.go.kr) SEMAS 수집(--semas)에만 사용
DATA_GO_KR_SERVICE_KEY=

# OPENAI_API_KEY는 콜드스타트에 필요하지 않습니다.
# 기각된 비정형 실험 경로에서만 사용하므로 이 템플릿에 넣지 않습니다.
