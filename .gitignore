.env
.env.bak
kb.db
kb.db-wal
kb.db-shm
# 작업용 사본·백업 (콜드런 산출물, 교체 전 원본 등). 개별 이름을 나열하면
# 새 사본이 생길 때마다 빠뜨린다.
kb-*.db
kb-*.db-wal
kb-*.db-shm
pipeline/cache/
backups/
probe/results/
__pycache__/
*.pyc
archive/

# lane worktrees (created outside the tree by lanes/setup-worktrees.ps1)
enter.ps1

# lane A model split cache (rebuilt from kb.db, fingerprinted on feature source)
model/.cache/

# 실험 스크래치 (판정 표본·중간 산출물) — 결과는 docs/ 에 기록한다
scratch_*

# 판정 서브에이전트가 저장소 루트에 남기는 임시 스크립트
temp_*.py
analyze_*.py
# anatomy 코드그래프 캐시 (레포에서 재생성된다)
.codegraph/

# 제출 zip — 90MB 산출물이고 scripts/package_submission.py 가 언제든 다시 만든다.
# 저장소에 넣으면 clone 이 무거워지고, 무엇보다 «어느 zip 을 냈는지»가 파일이
# 아니라 그 스크립트와 커밋으로 결정돼야 한다.
submission/
